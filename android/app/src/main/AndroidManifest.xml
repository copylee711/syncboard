<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for the step-by-step banner shown over Settings (see DevOptions). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installing a downloaded update when the phone service isn't running. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- PairHelper: a few minutes in the foreground while the user scans the PC's QR. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- So PairHelper keeps running in the background while the user scans (non-vivo ROMs). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Granted over adb during setup; lets the app turn wireless debugging on after a reboot. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- To show approved apps by name in 设置 → 已授权的应用. -->
    <queries>
        <package android:name="app.twinfile" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="SyncBoard"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncBoard">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.syncboard.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- 手机通知同步 (off by default); the phone service grants it notification access. -->
        <service
            android:name=".ipc.NotifListener"
            android:exported="true"
            android:label="SyncBoard 通知同步"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".ipc.PairHelper"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Another app (TwinFile) asks to use the phone service; the user approves here. -->
        <activity
            android:name=".ui.AuthorizeClientActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="app.syncboard.action.AUTHORIZE_CLIENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="发送到电脑"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.OpenOnPcActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="在电脑上打开"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ShareClipActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="复制到电脑剪贴板"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.SyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="SyncBoard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ipc.Recovery$Job"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".ipc.Recovery$BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ipc.ClipProvider"
            android:authorities="app.syncboard.clip"
            android:exported="true" />
    </application>
</manifest>
